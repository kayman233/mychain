  "definitions": {
    "Binary": {
      "description": "Binary is a wrapper around Vec<u8> to add base64 de/serialization with serde. It also adds some helper methods to help encode inline.\n\nThis is only needed as serde-json-{core,wasm} has a horrible encoding for Vec<u8>. See also <https://github.com/CosmWasm/cosmwasm/blob/main/docs/MESSAGE_TYPES.md>.",
      "type": "string"
    },
    "OAuthAttestation": {
      "type": "object",
      "required": [
        "action",
        "chain_id",
        "contract",
        "expires_at",
        "nonce",
        "provider",
        "sub_hash"
      ],
      "properties": {
        "action": {
          "$ref": "#/definitions/OAuthAttestationAction"
        },
        "chain_id": {
          "type": "string"
        },
        "contract": {
          "type": "string"
        },
        "expires_at": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "new_pubkey": {
          "anyOf": [
            {
              "$ref": "#/definitions/Binary"
            },
            {
              "type": "null"
            }
          ]
        },
        "nonce": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "share_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "sub_hash": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "OAuthAttestationAction": {
      "type": "string",
      "enum": [
        "recover",
        "revoke",
        "store_share"
      ]
    },
    "OAuthAttestationProof": {
      "type": "object",
      "required": [
        "attestation",
        "signature"
      ],
      "properties": {
        "attestation": {
          "$ref": "#/definitions/OAuthAttestation"
        },
        "signature": {
          "$ref": "#/definitions/Binary"
        }
      },
      "additionalProperties": false
    }
